{
  "name": "typeface-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "catalog:build": "node scripts/build-google-catalog.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons:build": "node --experimental-strip-types --no-warnings scripts/build-icon-data.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@mdi/svg": "^7.4.47",
    "@vercel/blob": "^2.8.0",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "bootstrap-icons": "^1.13.1",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "jose": "^6.2.12",
    "marked": "^18.0.14",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "subset-font": "^2.9.0",
    "svg2ttf": "^6.1.0",
    "svgpath": "^2.6.0",
    "undici": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/svg2ttf": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
