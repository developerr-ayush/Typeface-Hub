# Postgres connection string. On Vercel, add a Neon database from the
# Marketplace (Storage tab) and it sets DATABASE_URL for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/typeface_hub

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob token. On Vercel, create a Blob store (Storage tab) and it is set
# for you. Leave empty locally to store files in ./.data/storage instead.
BLOB_READ_WRITE_TOKEN=

# Optional but recommended on Vercel: a second, *private* Blob store for
# original font files and cached kits, so they can't be downloaded by URL.
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Optional: send password-reset emails with Resend (https://resend.com).
# Without these, reset links are written to the server log.
RESEND_API_KEY=
EMAIL_FROM="Typeface Hub <fonts@example.com>"

# Optional: Google Fonts Developer API key for a live catalogue. Without it the
# bundled catalogue in src/data/google-fonts.json is used.
GOOGLE_FONTS_API_KEY=

# Recommended: the public URL, used for password-reset links, generated CSS, the
# sitemap and social previews. On Vercel it defaults to the production domain.
NEXT_PUBLIC_APP_URL=

# Recommended: who runs the service and how to reach them (Privacy, Terms, footer).
OPERATOR_NAME=
CONTACT_EMAIL=
